// Enrollment Management System - Prisma Schema
// PostgreSQL relational schema covering users, academic structure,
// enrollment workflow, grading, payments, announcements, attendance,
// and audit logging.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth & Users
// ============================================================

enum Role {
  ADMIN
  REGISTRAR
  FACULTY
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  firstName       String
  lastName        String
  role            Role
  status          UserStatus   @default(ACTIVE)
  avatarUrl       String?
  phone           String?
  address         String?

  // role-specific profiles
  studentProfile  StudentProfile?
  facultyProfile  FacultyProfile?

  // relations
  announcements   Announcement[] @relation("AnnouncementAuthor")
  notifications   Notification[]
  auditLogs       AuditLog[]
  passwordResets  PasswordResetToken[]
  approvals       Enrollment[]   @relation("EnrollmentApprover")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([role])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Academic Structure
// ============================================================

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  courses     Course[]
  faculty     FacultyProfile[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  totalUnits   Int      @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  curriculum   CurriculumEntry[]
  students     StudentProfile[]
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
}

model Subject {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  units         Int      @default(3)
  lectureHours  Int      @default(3)
  labHours      Int      @default(0)

  prerequisites SubjectPrerequisite[] @relation("SubjectPrereqOf")
  postrequisites SubjectPrerequisite[] @relation("SubjectIsPrereqFor")

  sections      Section[]
  curriculumEntries CurriculumEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SubjectPrerequisite {
  id              String  @id @default(cuid())
  subjectId       String
  prerequisiteId  String
  subject         Subject @relation("SubjectPrereqOf", fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisite    Subject @relation("SubjectIsPrereqFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([subjectId, prerequisiteId])
}

model CurriculumEntry {
  id         String  @id @default(cuid())
  courseId   String
  subjectId  String
  yearLevel  Int     @default(1) // 1..5
  term       Int     @default(1) // 1..3 (sem/tri)

  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([courseId, subjectId])
  @@index([courseId, yearLevel, term])
}

// ============================================================
// School Calendar
// ============================================================

model SchoolYear {
  id        String   @id @default(cuid())
  name      String   @unique // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  semesters Semester[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SemesterTerm {
  FIRST
  SECOND
  SUMMER
}

model Semester {
  id           String       @id @default(cuid())
  schoolYearId String
  term         SemesterTerm
  startDate    DateTime
  endDate      DateTime
  enrollmentStart DateTime?
  enrollmentEnd   DateTime?
  isActive     Boolean      @default(false)

  schoolYear   SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]
  payments     Payment[]

  @@unique([schoolYearId, term])
  @@index([isActive])
}

// ============================================================
// Faculty / Student profiles
// ============================================================

model FacultyProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  employeeNo   String  @unique
  rank         String?
  departmentId String?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  sections     Section[]
  announcements Announcement[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum StudentLevel {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
  FIFTH_YEAR
  GRADUATE
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  studentNo   String   @unique
  courseId    String?
  yearLevel   StudentLevel @default(FIRST_YEAR)
  birthDate   DateTime?
  gender      String?
  guardianName String?
  guardianPhone String?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course? @relation(fields: [courseId], references: [id])
  enrollments Enrollment[]
  payments    Payment[]
  attendance  Attendance[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, yearLevel])
}

// ============================================================
// Sections, Schedules, Enrollments
// ============================================================

model Section {
  id          String   @id @default(cuid())
  code        String   // e.g., "CS101-A"
  subjectId   String
  semesterId  String
  facultyId   String?
  room        String?
  capacity    Int      @default(40)
  enrolled    Int      @default(0)

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  faculty     FacultyProfile? @relation(fields: [facultyId], references: [id])
  schedules   Schedule[]
  enrollments Enrollment[]
  attendance  Attendance[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, semesterId])
  @@index([semesterId])
  @@index([facultyId])
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Schedule {
  id         String   @id @default(cuid())
  sectionId  String
  day        DayOfWeek
  startTime  String   // "08:00"
  endTime    String   // "09:30"
  room       String?

  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([day, startTime])
}

enum EnrollmentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
  COMPLETED
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  sectionId   String
  semesterId  String
  status      EnrollmentStatus @default(PENDING)
  notes       String?
  approvedById String?
  approvedAt  DateTime?

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section     Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  semester    Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  approvedBy  User?          @relation("EnrollmentApprover", fields: [approvedById], references: [id])
  grade       Grade?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, sectionId])
  @@index([semesterId])
  @@index([status])
}

// ============================================================
// Grades
// ============================================================

model Grade {
  id            String   @id @default(cuid())
  enrollmentId  String   @unique
  prelim        Float?
  midterm       Float?
  finals        Float?
  finalGrade    Float?
  remarks       String?
  postedAt      DateTime?
  postedById    String?

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// Payments / Assessment
// ============================================================

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  semesterId  String
  tuition     Float    @default(0)
  miscFees    Float    @default(0)
  discount    Float    @default(0)
  totalDue    Float    @default(0)
  amountPaid  Float    @default(0)
  status      PaymentStatus @default(UNPAID)
  scholarship String?
  notes       String?

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester    Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, semesterId])
  @@index([status])
}

model PaymentTransaction {
  id         String   @id @default(cuid())
  paymentId  String
  amount     Float
  method     String   // CASH, BANK, ONLINE
  reference  String?
  paidAt     DateTime @default(now())

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================
// Announcements / Notifications
// ============================================================

enum AnnouncementAudience {
  ALL
  STUDENTS
  FACULTY
  REGISTRAR
  ADMIN
  SECTION
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  audience   AnnouncementAudience @default(ALL)
  sectionId  String?
  authorId   String
  authorFacultyId String?
  pinned     Boolean  @default(false)
  publishedAt DateTime @default(now())

  author     User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorFaculty FacultyProfile? @relation(fields: [authorFacultyId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([audience])
  @@index([sectionId])
}

enum NotificationType {
  ENROLLMENT
  GRADE
  PAYMENT
  SCHEDULE
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ============================================================
// Attendance
// ============================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  sectionId String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remarks   String?

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section   Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId, date])
  @@index([sectionId, date])
}

// ============================================================
// Audit
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE | UPDATE | DELETE | LOGIN | APPROVE ...
  entity    String   // User | Enrollment | Course ...
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
