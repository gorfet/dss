# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dss_enrollment?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# App
APP_NAME="DSS Enrollment"
